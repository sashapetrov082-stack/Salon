# --- Домен (Caddy получит HTTPS-сертификат автоматически) ---
DOMAIN=example.ru

# --- Telegram ---
BOT_TOKEN=
BOT_USERNAME=
WEBHOOK_BASE_URL=https://example.ru
# Случайная строка: используется в пути webhook и в X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=

# --- База данных ---
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app
DATABASE_URL=postgresql+asyncpg://app:<POSTGRES_PASSWORD>@postgres:5432/app

# --- Mini App и файлы ---
MINIAPP_URL=https://example.ru/app/
UPLOADS_DIR=/data/uploads
UPLOADS_BASE_URL=https://example.ru/uploads/

# --- Суперадмин (SQLAdmin на /admin) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Ошибки ---
SENTRY_DSN=
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Необязательно ---
# Путь внутри контейнера api к HTML-странице политики ПДн (иначе встроенная заглушка)
PRIVACY_HTML_PATH=

# --- Бэкап (deploy/backup.sh, S3-совместимое хранилище) ---
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=https://s3.storage.selcloud.ru
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-1
BACKUP_KEEP_DAYS=30
